# ==== LLM provider ====
# "openai" (default) or "ollama" (fully local, no API key required)
LLM_PROVIDER=openai

# ==== OpenAI (used when LLM_PROVIDER=openai) ====
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==== Ollama (used when LLM_PROVIDER=ollama) ====
# Make sure `ollama serve` is running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
# llama3.2 is text-only. Pull a vision model for real figure descriptions:
#   ollama pull llama3.2-vision
# Without it, figure descriptions fall back to their captions.
OLLAMA_VISION_MODEL=llama3.2-vision
# llama3.2 cannot embed text. Pull a dedicated embedding model:
#   ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==== Vector Store ====
# "chroma" today; architecture allows swapping to "qdrant" later
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION_NAME=research_papers

# Reserved for future Qdrant swap
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==== PostgreSQL (application metadata) ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
USE_POSTGRES=false

# ==== Storage paths ====
DATA_DIR=./data
PAPERS_DIR=./data/papers
IMAGES_DIR=./data/images
PROCESSED_DIR=./data/processed

# ==== Web search tool (optional) ====
SERPAPI_API_KEY=

# ==== Langfuse (observability) ====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENABLE_LANGFUSE=false

# ==== App behaviour ====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=6
MAX_REVIEW_RETRIES=2
LOG_LEVEL=INFO

# ==== FastAPI ====
API_HOST=0.0.0.0
API_PORT=8000

# ==== MCP ====
MCP_SERVER_HOST=127.0.0.1
MCP_CALCULATOR_PORT=8765
MCP_DOCUMENT_PORT=8766
MCP_SEARCH_PORT=8767
